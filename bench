#!/usr/bin/env bash

seed=0
args=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --seed)
            seed="$2"
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

# same number, so a run is fully reproducible
PYTHONHASHSEED="$seed" python -u test/bench.py --seed "$seed" "${args[@]}"
